 "phrases": [
  {
   "t0": 0.05,
   "t1": 2.81,
   "text": "Five things are slowly ruining your heart."
  },
  {
   "t0": 3.25,
   "t1": 5.5,
   "text": "And Imam Ibn al-Qayyim, rahimahullah,"
  },
  {
   "t0": 5.55,
   "t1": 6.67,
   "text": "named every one of them."
  },
  {
   "t0": 7.33,
   "t1": 8.99,
   "text": "One. Too much company."
  },
  {
   "t0": 9.52,
   "t1": 11.95,
   "text": "Constant crowds fill the heart with smoke…"
  },
  {
   "t0": 12.44,
   "t1": 13.56,
   "text": "until it turns dark."
  },
  {
   "t0": 14.08,
   "t1": 15.33,
   "text": "Be with people in good."
  },
  {
   "t0": 15.75,
   "t1": 17.01,
   "text": "Step back from the rest."
  },
  {
   "t0": 17.58,
   "t1": 19.21,
   "text": "Two. Wishful thinking."
  },
  {
   "t0": 19.7,
   "t1": 21.14,
   "text": "A sea with no shore."
  },
  {
   "t0": 21.62,
   "t1": 24.39,
   "text": "He called empty wishes the capital of the broke."
  },
  {
   "t0": 24.91,
   "t1": 28.31,
   "text": "Three. Hanging your heart on anything other than Allah."
  },
  {
   "t0": 28.73,
   "t1": 29.26,
   "text": "And he said…"
  },
  {
   "t0": 29.7,
   "t1": 31.52,
   "text": "this one is the worst of them all."
  },
  {
   "t0": 32.1,
   "t1": 33.72,
   "text": "Four. Too much food."
  },
  {
   "t0": 34.17,
   "t1": 36.44,
   "text": "Eat a lot, drink a lot, sleep a lot…"
  },
  {
   "t0": 36.82,
   "t1": 37.53,
   "text": "lose a lot."
  },
  {
   "t0": 38.07,
   "t1": 39.77,
   "text": "Five. Too much sleep."
  },
  {
   "t0": 40.17,
   "t1": 42.44,
   "text": "It deadens the heart, and wastes your time."
  },
  {
   "t0": 42.93,
   "t1": 43.96,
   "text": "Five corrupters."
  },
  {
   "t0": 44.33,
   "t1": 44.97,
   "text": "One heart."
  },
  {
   "t0": 45.42,
   "t1": 46.05,
   "text": "Guard it."
  }
 ],
