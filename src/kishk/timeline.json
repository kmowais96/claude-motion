 "lines": [
  {
   "s": 3.7,
   "e": 9.1,
   "text": "Whoever wants a companion, Allah is sufficient for him.",
   "key": "companion"
  },
  {
   "s": 9.2,
   "e": 15.7,
   "text": "And whoever wants a proof, the Qur'an is sufficient for him.",
   "key": "proof"
  },
  {
   "s": 15.8,
   "e": 21.9,
   "text": "And whoever wants wealth, contentment is sufficient for him.",
   "key": "wealth"
  },
  {
   "s": 21.9,
   "e": 28.3,
   "text": "And whoever wants a reminder, death is sufficient for him.",
   "key": "reminder"
  },
  {
   "s": 29.0,
