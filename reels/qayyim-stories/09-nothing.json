  "cards": [
    {
      "in": 0.05,
      "out": 3.75,
      "text": "Ibn al-Qayyim often heard his teacher say three *things.*",
      "shape": "spark"
    },
    {
      "in": 3.85,
      "out": 6.4,
      "text": "“I own *nothing.*”",
      "shape": "ring"
    },
    {
      "in": 6.5,
      "out": 8.35,
      "text": "“Nothing comes from *me.*”",
      "shape": "line"
    },
    {
      "in": 8.45,
      "out": 10.65,
      "text": "“And there is nothing in *me.*”",
      "shape": "scatter"
    },
    {
      "in": 10.75,
      "out": 13.75,
      "text": "This is the man they called the *Shaykh of Islam.*",
      "shape": "emblem"
    },
    {
      "in": 13.85,
      "out": 16.3,
      "text": "And when people praised him to his *face,*",
      "shape": "halves"
    },
    {
      "in": 16.4,
      "out": 20.8,
      "text": "he said: “By Allah, I renew my Islam every *moment.*”",
      "shape": "star8",
      "flare": true
    },
    {
      "in": 20.9,
      "out": 23.6,
      "text": "“I have not yet become a Muslim *properly.*”",
      "shape": "wave"
    },
    {
      "in": 23.7,
      "out": 26.8,
      "text": "The closer he came, the *smaller* he felt.",
      "shape": "spiral"
    }
